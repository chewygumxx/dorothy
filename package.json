{
    "name": "dorothy",
    "version": "1.0.0",
    "description": "Conversational LLM interface",
    "private": true,
    "type": "module",
    "keywords": [
        "llm",
        "chatbot",
        "dorothy"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/dorothy",
    "repository": "github:chewygumxx/dorothy",
    "engines": {
        "bun": ">=1.4"
    },
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "@dorothy/cli": "workspace:*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.15",
        "markdownlint-cli2": "^0.23.3",
        "@chewygumxx/biome-config": "^1.0.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/markdownlint-cli2-config": "^1.0.1",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@chewygumxx/yamllint-config": "^1.0.0",
        "@commitlint/cli": "^21.2.2",
        "@types/bun": "^1.4.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.10",
        "remark-cli": "^12.0.1",
        "typescript": "^7.0.2",
        "skills": "1.7.2",
        "superpowers": "github:obra/superpowers#v6.4.1",
        "sync-header-metadata": "2.4.2"
    },
    "scripts": {
        "check": "bun run typecheck && bun run format:check && bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:secrets && bun run lint:emdash && bun run lint:header && bun run test",
        "commit": "cz",
        "dev": "bun packages/cli/src/index.ts",
        "eval": "bun packages/eval/src/main.ts",
        "format": "git ls-files -z -co --exclude-standard | xargs -0 -r biome format --write --files-ignore-unknown=true --no-errors-on-unmatched && bun run format:yaml",
        "format:check": "git ls-files -z -co --exclude-standard | xargs -0 -r biome format --files-ignore-unknown=true --no-errors-on-unmatched",
        "format:header": "sync-header-metadata --update",
        "format:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --write --log-level warn",
        "lint": "git ls-files -z -co --exclude-standard | xargs -0 -r biome lint --files-ignore-unknown=true --no-errors-on-unmatched",
        "lint:emdash": "git grep -nIP --untracked '\\x{2014}'; test $? -eq 1",
        "lint:secrets": "sh scripts/check-secrets.sh --tracked",
        "lint:header": "sync-header-metadata",
        "lint:md": "git ls-files -z '*.md' | xargs -0 remark --frail --quiet --no-stdout && git ls-files -z '*.md' | xargs -0 -r markdownlint-cli2",
        "lint:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --check && git ls-files -z '*.yaml' '*.yml' | YAMLLINT_CONFIG_FILE=node_modules/@chewygumxx/yamllint-config/config.yaml xargs -0 -r yamllint --strict",
        "prepare": "sh scripts/prepare.sh",
        "skills": "DO_NOT_TRACK=1 skills experimental_sync -y --agent claude-code codex --exclude 'superpowers#using-git-worktrees' --exclude 'superpowers#using-superpowers' --exclude 'superpowers#diagnosing-superpowers' --exclude 'superpowers#writing-skills'",
        "start": "bun packages/cli/src/index.ts",
        "test": "bun test",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "skills": [
        {
            "source": "herdrdev/herdr",
            "ref": "2ecf19a92fc3a7fff75b6ce3655ef04f4625ec01",
            "skills": [
                "herdr"
            ]
        }
    ],
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    },
    "patchedDependencies": {
        "isomorphic-git@1.43.1": "patches/isomorphic-git@1.43.1.patch"
    }
}
