{
    "name": "dorothy",
    "version": "1.0.0",
    "description": "Conversational LLM interface",
    "private": true,
    "type": "module",
    "keywords": [
        "llm",
        "chatbot",
        "dorothy"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/dorothy",
    "repository": "github:chewygumxx/dorothy",
    "engines": {
        "bun": ">=1.4"
    },
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "@dorothy/cli": "workspace:*"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "markdownlint-cli2": "^0.23.3",
        "@chewygumxx/biome-config": "^1.0.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/markdownlint-cli2-config": "^1.0.1",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@chewygumxx/yamllint-config": "^1.0.0",
        "@commitlint/cli": "^21.2.2",
        "@dotenvx/dotenvx": "^2.32.4",
        "@types/bun": "^1.4.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.9",
        "remark-cli": "^12.0.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "check": "bun run typecheck && bun run format:check && bun run lint && bun run lint:md && bun run lint:yaml && bun run lint:env && bun run lint:emdash && bun run test",
        "commit": "cz",
        "dev": "bun packages/cli/src/index.ts",
        "format": "git ls-files -z -co --exclude-standard | xargs -0 -r biome format --write --files-ignore-unknown=true --no-errors-on-unmatched && bun run format:yaml",
        "format:check": "git ls-files -z -co --exclude-standard | xargs -0 -r biome format --files-ignore-unknown=true --no-errors-on-unmatched",
        "format:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --write --log-level warn",
        "lint": "git ls-files -z -co --exclude-standard | xargs -0 -r biome lint --files-ignore-unknown=true --no-errors-on-unmatched",
        "lint:emdash": "git grep -nIP --untracked '\\x{2014}'; test $? -eq 1",
        "lint:env": "git ls-files -z -- ':(glob)**/.env*' ':(glob)**/*.env' | xargs -0 -r -n1 sh -c 'dotenvx protect --git-file \"$1\" <\"$1\" >/dev/null' sh",
        "lint:md": "git ls-files -z '*.md' | xargs -0 remark --frail --quiet --no-stdout",
        "lint:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --check && git ls-files -z '*.yaml' '*.yml' | YAMLLINT_CONFIG_FILE=node_modules/@chewygumxx/yamllint-config/config.yaml xargs -0 -r yamllint --strict",
        "prepare": "test -d node_modules/husky && husky || true",
        "start": "bun packages/cli/src/index.ts",
        "test": "bun test",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    }
}
