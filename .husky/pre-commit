#!/usr/bin/env sh
# vim:set expandtab shiftwidth=4 filetype=sh:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/dorothy.git
# ::: :/.husky/pre-commit
#
#

set -e

bunx --bun --no-install tsc
bunx --bun --no-install biome check --staged --no-errors-on-unmatched

git diff -z --cached --name-only --diff-filter=ACMR -- '*.md' |
    xargs -0 -r bunx --bun --no-install remark --frail --quiet --no-stdout

yaml=$(git diff --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml')
if [ -n "$yaml" ]; then
    git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
        xargs -0 bunx --bun --no-install prettier --check
    git diff -z --cached --name-only --diff-filter=ACMR -- '*.yaml' '*.yml' |
        YAMLLINT_CONFIG_FILE=node_modules/@chewygumxx/yamllint-config/config.yaml \
            xargs -0 yamllint --strict
fi

# .env is committed encrypted, so refuse any staged env file holding a
# plaintext value, and any .env.keys private-key file. The check is
# dotenvx's own (`protect --git-file`, fed the staged blob rather than the
# working tree); `dotenvx protect` itself is avoided because it installs a
# required clean filter into the global git config instead of this repo.
git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r file; do
    case "${file##*/}" in
        .env* | *.env)
            git show ":$file" |
                bunx --bun --no-install dotenvx protect --git-file "$file" >/dev/null ||
                exit 1
            ;;
    esac
done

# U+2014 as UTF-8 bytes, so this file does not trip its own check.
emdash=$(printf '\342\200\224')
if git diff --cached -U0 | grep '^+' | grep -q "$emdash"; then
    echo "Em dash (U+2014) in staged changes; em dashes are prohibited." >&2
    exit 1
fi
